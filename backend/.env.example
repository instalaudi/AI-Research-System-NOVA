# AI Research System Configuration
# Copy this file to .env and set your actual values
# ⚠️ WARNING: Never sync .env to cloud storage (OneDrive, Dropbox, etc.)

# Security - CHANGE THESE IN PRODUCTION!
API_KEY=CHANGE_ME_your_api_key_here
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:3000,http://localhost:9999

# Rate Limiting Configuration
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# LLM Configuration (Ollama)
# OPTIMIZADO PARA RYZEN 7 5700G (CPU + iGPU)
LLM_MODEL_NAME=qwen2.5:1.5b
LLM_FAST_MODEL=qwen2.5:1.5b
LLM_EMBED_MODEL=all-MiniLM-L6-v2
USE_LOCAL_EMBEDDINGS=true
OLLAMA_URL=http://localhost:11438/api/chat
LLM_DEV_URL=http://localhost:11439/api/chat
LLM_AUDIT_URL=http://localhost:11440/api/chat
LLM_AUDIT_MODEL=phi3:mini
LLM_VISION_MODEL=llava-llama3:latest

# Optimizaciones para CPU (Ryzen 7 5700G)
OLLAMA_NUM_THREAD=4
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=2048

# Cognitive Mode
COGNITIVE_MODE=balanced

# JWT Secret Key - Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=CHANGE_ME_generate_with_secrets_token_hex

# Telegram (Opcional)
TELEGRAM_TOKEN=CHANGE_ME_your_telegram_bot_token
TELEGRAM_CHAT_ID=CHANGE_ME_your_chat_id

# Distillation Tuning (CPU local estable)
DISTILL_MODEL_REASONING=qwen2.5:3b
DISTILL_MODEL_GENERAL=qwen2.5:3b
DISTILL_MODEL_CREATIVE=qwen2.5:3b
DISTILL_MAX_CONCURRENCY=2
DISTILL_MASTER_TIMEOUT_SECONDS=300

# Concurrencia Maestra
LLM_CONCURRENCY=2

# Control Center API Key (for launcher_server.py)
CC_API_KEY=CHANGE_ME_your_control_center_key

# STT (Speech-to-Text) — Whisper model
# Options: base, small, medium, large-v3, turbo (large-v3-turbo)
WHISPER_MODEL=turbo
